[
    {
        "tc_id": "TC-ADMIN-001",
        "module": "Admin Panel — Purchase Orders",
        "description": "End-to-end PO lifecycle: admin creates PO with 2 distinct line items → sends to seller → accepts → edits → packs → uploads ready proof → creates & manifests an FTL shipment → marks Ready for Dispatch. Single test, 21 checkpoints, each business action recorded independently.",
        "preconditions": "Admin user has access to PO module. Vendor 'M&M_Brand1' exists. Warehouse 'CUTTACK WH' (or similar) exists under Agrim Branch ODISHA. Product search 'test' returns at least 2 distinct products. At least one transporter exists for the FTL shipment dropdown.",
        "checkpoints": [
            "Open PO listing",
            "Open Create PO form",
            "Select vendor + auto-populate addresses",
            "Select Agrim Branch",
            "Select Delivery Address (warehouse)",
            "Set Load Type",
            "Set PO Type and Inventory Purchase type",
            "Add line item 1 (first product)",
            "Add line item 2 (distinct second product)",
            "Save Changes — create PO",
            "Open created PO from listing",
            "Verify PO detail page",
            "Send to Seller",
            "Accept PO",
            "Open Edit form",
            "Update PO",
            "Pack PO (with Confirm)",
            "Upload ready proof",
            "Create + manifest shipment",
            "Mark Ready",
            "Verify no errors on final state"
        ],
        "expected_result": "PO progresses Draft → Sent To Seller → Accepted → Packed → Ready For Dispatch. A manifested FTL shipment is created (required before Ready). No error toasts on the page."
    },
