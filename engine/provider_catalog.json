{
  "_comment": "BYOK provider presets shared by the Electron UI (via main.js) and the Python engine (model_profiles.py). A profile in config.json llm.providers names a preset with \"preset\"; any field set on the profile overrides the preset. Secrets are never stored here or in config.json - only the env var NAME that carries the key. Verified against provider docs 2026-10-04.",
  "version": 1,
  "presets": {
    "mimo": {
      "label": "Xiaomi MiMo",
      "protocol": "openai",
      "api_key_env": "MIMO_API_KEY",
      "key_url": "https://platform.xiaomimimo.com/#/console/api-keys",
      "docs_url": "https://mimo.mi.com/docs/en-US/quick-start/faq/api-integration",
      "endpoints": [
        {
          "id": "payg",
          "label": "Pay-as-you-go (sk- keys)",
          "base_url": "https://api.xiaomimimo.com/v1",
          "key_prefix": "sk-"
        },
        {
          "id": "tp-sgp",
          "label": "Token Plan - Singapore (tp- keys)",
          "base_url": "https://token-plan-sgp.xiaomimimo.com/v1",
          "key_prefix": "tp-"
        },
        {
          "id": "tp-ams",
          "label": "Token Plan - Europe (tp- keys)",
          "base_url": "https://token-plan-ams.xiaomimimo.com/v1",
          "key_prefix": "tp-"
        },
        {
          "id": "tp-cn",
          "label": "Token Plan - China (tp- keys)",
          "base_url": "https://token-plan-cn.xiaomimimo.com/v1",
          "key_prefix": "tp-"
        }
      ],
      "default_model": "mimo-v2.6-flash",
      "models": [
        {
          "id": "mimo-v2.6-flash",
          "label": "MiMo V2.6 Flash - fast, cheap",
          "vision": true
        },
        {
          "id": "mimo-v2.6-pro",
          "label": "MiMo V2.6 Pro - flagship",
          "vision": true
        },
        {
          "id": "mimo-v2.6-pro-ultraspeed",
          "label": "MiMo V2.6 Pro Ultraspeed",
          "vision": true
        }
      ],
      "max_tokens": 16384,
      "token_parameter": "max_completion_tokens",
      "supports_temperature": false,
      "thinking_field": "reasoning_content",
      "thinking": {
        "default": "on",
        "on": {
          "extra_body": {
            "thinking": {
              "type": "enabled"
            }
          }
        },
        "off": {
          "extra_body": {
            "thinking": {
              "type": "disabled"
            }
          }
        }
      },
      "validate": {
        "method": "models"
      }
    },
